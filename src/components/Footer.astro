---
const year = new Date().getFullYear();
---
<footer class="shell footer">
  <span>© {year} Adefila Abdulmuiz</span>
  <span>Lagos, Nigeria · Mobile & frontend</span>
  <a href="/contact">Say hello ↗︎</a>
</footer>
<style>
  .footer{display:flex;justify-content:space-between;align-items:center;gap:30px;padding-top:18px;padding-bottom:32px;font-size:12px;font-weight:700;color:#5a5d75}
  .footer a{color:var(--ink);border-bottom:1px solid var(--orange)}
  @media(max-width:800px){.footer{flex-wrap:wrap}}
  @media(max-width:520px){.footer{font-size:11px;gap:12px}}
</style>
