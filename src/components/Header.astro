---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="shell topbar">
  <a class="brand" href="/" aria-label="Adefila home">adefila<span>.</span></a>
  <nav class="nav" aria-label="Main navigation">
    <a class:active={path === '/software' || path.startsWith('/work/')} href="/software">Work</a>
    <a class:active={path === '/about'} href="/about">About</a>
    <a class="nav-cta" href="/contact">Let's talk ↗</a>
  </nav>
  <details class="mobile-menu">
    <summary>Menu <span aria-hidden="true">＋</span></summary>
    <nav aria-label="Mobile navigation">
      <a href="/software">Work</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
    </nav>
  </details>
</header>
<style>
  .topbar{height:86px;display:flex;align-items:center;justify-content:space-between;gap:32px;position:relative;z-index:20}
  .brand{font-family:var(--font-display);font-weight:800;letter-spacing:-.04em;font-size:29px;line-height:1}.brand span{color:var(--orange)}
  .nav{display:flex;align-items:center;gap:34px;font-size:13px;font-weight:800}.nav a:not(.nav-cta){transition:color .2s}.nav a:not(.nav-cta):hover,.nav a.active{color:var(--blue)}
  .nav-cta{background:var(--ink);color:white;padding:14px 21px;border-radius:100px;transition:background .25s,transform .35s cubic-bezier(.16,1,.3,1)}.nav-cta:hover{background:var(--blue);transform:translateY(-3px)}
  .mobile-menu{display:none}.mobile-menu summary{list-style:none;cursor:pointer;font-size:13px;font-weight:800;background:var(--white);border-radius:100px;padding:11px 16px}.mobile-menu summary::-webkit-details-marker{display:none}.mobile-menu summary span{font-size:17px;margin-left:6px}.mobile-menu[open] summary span{display:inline-block;transform:rotate(45deg)}.mobile-menu nav{position:absolute;top:66px;right:16px;min-width:185px;display:grid;gap:0;padding:8px;background:var(--white);border-radius:16px;box-shadow:0 16px 32px rgba(25,27,53,.14)}.mobile-menu nav a{padding:12px 14px;border-radius:10px;font-size:14px;font-weight:800}.mobile-menu nav a:hover{background:var(--paper);color:var(--blue)}
  @media(max-width:800px){.topbar{height:70px}.brand{font-size:25px}.nav{margin-left:auto}.nav a:not(.nav-cta){display:none}.mobile-menu{display:block}.nav-cta{padding:12px 17px}}
  @media(max-width:420px){.topbar{gap:10px}.nav-cta{font-size:11px;padding:11px 13px}.mobile-menu summary{font-size:11px;padding:10px 11px}}
</style>
