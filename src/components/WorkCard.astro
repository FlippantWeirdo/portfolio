---
import type { WorkProject } from '../data/work';
interface Props { project: WorkProject; }
const { project } = Astro.props;
---
<a class:list={['project', project.tone]} href={`/work/${project.slug}`} aria-label={`View ${project.title} project`}>
  <span class="project-top"><span class="project-tag">{project.category} · {project.status}</span><span class="project-arrow" aria-hidden="true">↗</span></span>
  <h3>{project.title}</h3>
  <p>{project.cardText}</p>
  <div class="project-art" aria-hidden="true">
    {project.images.slice(0, project.tone === 'rosie' ? 2 : project.tone === 'nokslock' || project.tone === 'flamingo' ? 2 : 1).map((image, i) => (
      <img class:list={['screen', `screen-${i + 1}`]} src={image.src} alt="" loading="lazy" decoding="async" />
    ))}
  </div>
</a>
<style>
  .project{border-radius:18px;position:relative;overflow:hidden;isolation:isolate;min-height:420px;padding:34px 34px 0;transition:transform .5s cubic-bezier(.16,1,.3,1),box-shadow .5s;display:block}
  .project:hover{transform:translateY(-8px);box-shadow:0 24px 34px rgba(24,28,55,.13)}.project:focus-visible{outline-offset:3px}
  .project-top{position:relative;z-index:3;display:flex;align-items:flex-start;justify-content:space-between;gap:20px}
  .project-tag{display:inline-block;border:1px solid currentColor;border-radius:40px;padding:8px 12px;font-size:10px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;opacity:.9;line-height:1.4}
  .project-arrow{width:38px;height:38px;flex:none;border-radius:50%;display:grid;place-items:center;border:1.5px solid currentColor;font-size:22px;line-height:1;transition:transform .4s cubic-bezier(.16,1,.3,1)}.project:hover .project-arrow{transform:rotate(45deg)}
  h3{position:relative;z-index:3;font-size:clamp(36px,3.6vw,56px);font-weight:800;line-height:1;letter-spacing:-.04em;margin:27px 0 10px}
  p{position:relative;z-index:3;font-size:14px;font-weight:600;line-height:1.55;max-width:330px}
  .project-art{position:absolute;inset:0;z-index:2;pointer-events:none}.project-art img{position:absolute;display:block;max-width:none;transition:transform .6s cubic-bezier(.16,1,.3,1)}
  .nokslock{grid-column:span 7;background:#dfe8ff;min-height:580px}.nokslock h3{font-size:65px}.nokslock p{max-width:270px}.nokslock::before{content:"";position:absolute;right:-220px;bottom:-335px;width:740px;height:740px;border-radius:50%;background:#b6c9ff;z-index:0}
  .nokslock .screen-1{width:237px;right:200px;top:180px;transform:rotate(-10deg);border-radius:22px;box-shadow:0 25px 35px rgba(47,75,146,.25)}.nokslock .screen-2{width:245px;right:25px;top:125px;transform:rotate(9deg);border-radius:22px;box-shadow:0 25px 35px rgba(47,75,146,.25)}.nokslock:hover .screen-1{transform:rotate(-13deg) translateY(-12px)}.nokslock:hover .screen-2{transform:rotate(13deg) translateY(-18px)}
  .flamingo{grid-column:span 5;background:#111c0b;color:#f5f9eb;min-height:580px}.flamingo h3{font-size:62px;max-width:270px}.flamingo p{color:#cad5c3;max-width:235px}.flamingo::before{content:"";width:370px;height:370px;box-sizing:border-box;border-radius:50%;position:absolute;right:-125px;bottom:-115px;border:70px solid #d6ff50;z-index:0}.flamingo .screen-1{width:205px;right:100px;top:250px;transform:rotate(-11deg);border-radius:20px;box-shadow:0 25px 30px rgba(0,0,0,.45)}.flamingo .screen-2{width:205px;right:-30px;top:220px;transform:rotate(8deg);border-radius:20px;box-shadow:0 25px 30px rgba(0,0,0,.45)}.flamingo:hover .screen-1{transform:rotate(-15deg) translateY(-10px)}.flamingo:hover .screen-2{transform:rotate(12deg) translateY(-12px)}
  .admin{grid-column:span 5;background:#eaffad;min-height:425px;color:#14210d}.admin h3{font-size:48px;max-width:360px}.admin p{max-width:300px}.admin img{width:620px;right:-70px;bottom:-207px;transform:rotate(-7deg);border-radius:11px;border:5px solid white;box-shadow:0 25px 40px rgba(51,73,23,.19)}.admin:hover img{transform:rotate(-4deg) translateY(-8px)}
  .rosie{grid-column:span 7;background:#f6d5d9;min-height:425px;color:#5d1b2a}.rosie h3{font-size:58px}.rosie p{max-width:285px}.rosie::before{content:"";position:absolute;width:460px;height:460px;border-radius:50%;background:#eaaab3;right:-82px;bottom:-240px;z-index:0}.rosie .screen-1{width:215px;right:180px;top:145px;transform:rotate(-8deg);border-radius:22px;box-shadow:0 22px 35px rgba(92,37,58,.23)}.rosie .screen-2{width:340px;right:-75px;bottom:-30px;transform:rotate(8deg);border-radius:11px;box-shadow:0 22px 35px rgba(92,37,58,.23)}.rosie:hover .screen-1{transform:rotate(-12deg) translateY(-9px)}.rosie:hover .screen-2{transform:rotate(11deg) translateY(-7px)}
  .caxten{grid-column:span 7;background:#1f2841;min-height:390px;color:#f4f2ed}.caxten h3{max-width:350px;font-size:51px}.caxten p{max-width:250px;color:#ced7e6}.caxten img{width:500px;right:-65px;bottom:-125px;transform:rotate(-5deg);border-radius:10px;border:5px solid #f4f2ed;box-shadow:0 23px 40px rgba(0,0,0,.23)}.caxten:hover img{transform:rotate(-2deg) translateY(-8px)}
  .qstc{grid-column:span 5;min-height:390px;background:#fcae78;color:#442613}.qstc h3{font-size:56px}.qstc p{max-width:230px}.qstc img{width:490px;right:-189px;bottom:-58px;transform:rotate(8deg);border-radius:10px;border:5px solid #fff8e8;box-shadow:0 23px 40px rgba(123,63,25,.25)}.qstc:hover img{transform:rotate(4deg) translateY(-8px)}
  @media(max-width:1100px){.nokslock .screen-1{right:140px}.admin img{right:-280px}.rosie .screen-1{right:125px}.rosie .screen-2{right:-120px}}
  @media(max-width:800px){.project{grid-column:span 2!important;min-height:480px;padding:26px}.project h3{font-size:50px!important}.nokslock .screen-1{right:30%;width:180px;top:180px}.nokslock .screen-2{right:6%;width:190px;top:150px}.flamingo .screen-1{width:185px;right:25%;top:205px}.flamingo .screen-2{width:190px;right:0;top:195px}.admin img{right:-170px;width:610px;bottom:-150px}.rosie .screen-1{width:180px;right:30%;top:180px}.rosie .screen-2{width:320px;right:-65px;bottom:-25px}.caxten img{width:470px;right:-110px;bottom:-130px}.qstc img{width:440px;right:-120px}}
  @media(max-width:520px){.project{min-height:415px;padding:22px}.project h3{font-size:42px!important}.project p{font-size:12px;max-width:205px}.project-tag{font-size:9px}.nokslock .screen-1{width:142px;right:28%;top:178px}.nokslock .screen-2{width:147px;right:2%;top:150px}.flamingo .screen-1{width:146px;right:22%;top:218px}.flamingo .screen-2{width:147px;right:-6%;top:188px}.admin img{width:490px;right:-200px;bottom:-165px}.rosie .screen-1{width:150px;right:31%;top:190px}.rosie .screen-2{width:245px;right:-100px;bottom:0}.caxten img{width:350px;right:-155px;bottom:-105px}.qstc img{width:350px;right:-145px;bottom:-15px}}
</style>
