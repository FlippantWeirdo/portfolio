---
import Base from '../layouts/Base.astro';
import Ticker from '../components/Ticker.astro';
---
<Base title="About — Adefila Abdulmuiz" description="Meet Adefila Abdulmuiz, a mobile and frontend developer building thoughtful software with a little more life in it.">

        <section class="hero" aria-labelledby="about-title">
          <div class="hero-copy"><span class="eyebrow"><span class="dot"></span> A little about me</span><h1 id="about-title">A person behind the <em>pixels.</em></h1><p class="hero-lede">I'm <strong>Adefila Abdulmuiz</strong>. I build mobile apps and web experiences that are useful, thoughtful, and a little more alive. I'm open to mobile and frontend roles.</p><div class="hero-actions"><a class="button button-blue" href="/#work">See what I've built <span aria-hidden="true">↗</span></a><a class="quiet-link" href="#more">Get to know me ↓</a></div></div>
          <div class="portrait"><div class="portrait-art" role="img" aria-label="Stylized portrait illustration"><div class="head"></div><div class="body-shape"></div></div><div class="portrait-sticker">A LITTLE<br>MORE<br>HUMAN ✳</div><div class="portrait-open">I'M OPEN<br />TO WORK</div><span class="portrait-name">Hi, I'm<br>Adefila.</span></div>
        </section>
        <Ticker items={['MOBILE APPS WITH PURPOSE', 'FRONTEND WITH FEELING', 'DETAILS THAT MATTER']} />
        <section id="more" aria-labelledby="build-title"><div class="section-heading"><h2 id="build-title">What I bring<br>to the build.</h2><p>Different platforms, one goal: software people can understand and enjoy using.</p></div><div class="tiles">
          <article class="tile mobile"><span class="number">01 / MOBILE</span><h3>Made for the hand it lives in.</h3><p>Flutter and React Native work across real app flows, from the first tap to the everyday return visit.</p></article>
          <article class="tile frontend"><span class="number">02 / FRONTEND</span><h3>Web that feels considered.</h3><p>React, Next.js, and TypeScript interfaces with clear structure, careful details, and room for personality.</p></article>
          <article class="tile detail"><span class="number">03 / THE DETAILS</span><h3>The little moments count.</h3><p>Loading, feedback, movement, and the small decisions that make a product feel good to use.</p></article>
          <article class="tile background"><span class="number">04 / BACKGROUND</span><h3>Curiosity beyond code.</h3><p>My mechatronics background shaped how I think through systems and constraints. Software is where I focus that energy now.</p></article>
        </div></section>
        <section class="experience" aria-labelledby="experience-title"><div class="experience-grid"><div class="experience-intro"><h2 id="experience-title">A bit of<br><em>the path.</em></h2><p>Teams, client work, and products I've helped bring to life. The work itself tells the fuller story.</p></div><div class="experience-list"><article class="role"><small>Mobile development</small><div><h3>Decentralyne</h3><p>Cross-platform app work across mobile features and production interfaces.</p></div></article><article class="role"><small>Frontend development</small><div><h3>Downtown</h3><p>Company website and dashboard work, from design to working interface.</p></div></article><article class="role"><small>Independent projects</small><div><h3>Nokslock, Flamingo, Rosie & more</h3><p>Mobile and web products built with clients and collaborators.</p></div></article></div></div></section>
        <section class="contact" aria-labelledby="contact-title"><h2 id="contact-title">Have a role or an idea? Let's talk.</h2><a class="button" href="/contact">Send me a note ↗</a></section>

</Base>
<style>

      :root{--ink:#191b35;--blue:#3128c9;--orange:#ff7759;--lime:#d9ff5c;--paper:#eff0f8;--white:#fffefa;--muted:#53566f}
      *{box-sizing:border-box}html{scroll-behavior:smooth;background:var(--paper)}body{margin:0;background:var(--paper);color:var(--ink);font-family:Manrope,Arial,sans-serif}::selection{background:var(--lime);color:var(--ink)}a{color:inherit;text-decoration:none}a:focus-visible{outline:3px solid var(--orange);outline-offset:5px}h1,h2,h3,p{margin-top:0}h1,h2,h3{font-family:'Bricolage Grotesque',Arial,sans-serif}img{max-width:100%;display:block}.shell{max-width:1512px;margin:auto;padding:0 30px}
      .topbar{height:86px;display:flex;align-items:center;justify-content:space-between;gap:32px}.brand{font-family:'Bricolage Grotesque',sans-serif;font-weight:800;letter-spacing:-.04em;font-size:29px;line-height:1}.brand-dot{color:var(--orange)}.nav{display:flex;align-items:center;gap:34px;font-size:13px;font-weight:800}.nav a:not(.nav-cta){transition:color .2s}.nav a:not(.nav-cta):hover,.nav .active{color:var(--blue)}.nav-cta{background:var(--ink);color:white;padding:14px 21px;border-radius:100px;transition:background .25s,transform .35s cubic-bezier(.16,1,.3,1)}.nav-cta:hover{background:var(--blue);transform:translateY(-3px)}
      .hero{display:grid;grid-template-columns:minmax(0,1.14fr) minmax(0,.86fr);gap:18px;min-height:660px}.hero-copy{background:var(--white);border-radius:22px;padding:clamp(44px,5vw,76px);display:flex;flex-direction:column;align-items:flex-start;overflow:hidden;position:relative}.eyebrow{font-size:11px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.eyebrow .dot{display:inline-block;width:9px;height:9px;border-radius:50%;background:var(--orange);margin-right:8px}.hero h1{font-size:clamp(62px,6vw,91px);line-height:.95;letter-spacing:-.055em;font-weight:800;margin:55px 0 30px;max-width:760px}.hero h1 em{font-style:normal;color:var(--blue)}.hero-lede{font-size:18px;font-weight:600;line-height:1.65;max-width:550px;color:#494c65;margin:0 0 30px}.hero-lede strong{color:var(--ink);font-weight:800}.hero-actions{display:flex;align-items:center;gap:17px;flex-wrap:wrap;margin-top:auto}.button{display:inline-flex;align-items:center;justify-content:center;gap:20px;min-height:55px;padding:0 25px;border-radius:100px;font-size:13px;font-weight:800;transition:transform .35s cubic-bezier(.16,1,.3,1),background .2s}.button:hover{transform:translateY(-4px)}.button-blue{background:var(--blue);color:white}.button-blue:hover{background:var(--ink)}.quiet-link{font-size:13px;font-weight:800;border-bottom:2px solid var(--orange);padding:9px 0}.hero-copy::after{content:'✳';position:absolute;font-family:'Bricolage Grotesque',sans-serif;font-size:130px;color:#e7e5ff;right:25px;bottom:-45px;pointer-events:none;transform:rotate(-10deg)}
      .portrait{border-radius:22px;min-height:660px;background:var(--orange);position:relative;overflow:hidden;isolation:isolate}.portrait::before{content:'';position:absolute;width:640px;height:640px;border:1px solid rgba(25,27,53,.23);border-radius:50%;left:50%;top:50%;transform:translate(-50%,-49%);box-shadow:0 0 0 88px rgba(255,255,255,.1),0 0 0 174px rgba(255,255,255,.08)}.portrait::after{content:'✳';position:absolute;color:var(--lime);font-size:110px;right:18px;top:25px;line-height:1;animation:twirl 22s linear infinite}.portrait-art{position:absolute;inset:60px 20px 0;display:flex;align-items:end;justify-content:center}.head{position:absolute;width:190px;height:220px;border-radius:48% 48% 44% 44%;background:#a45c3d;top:93px;left:50%;transform:translateX(-50%);z-index:2;box-shadow:inset -21px -8px 0 rgba(77,33,34,.1)}.head::before{content:'';position:absolute;width:100%;height:93px;top:-7px;left:0;background:#232042;border-radius:50% 50% 25% 25%;transform:rotate(-5deg)}.body-shape{width:min(510px,100%);height:370px;border-radius:53% 53% 0 0;background:var(--blue);z-index:1}.portrait-sticker{position:absolute;z-index:4;background:var(--lime);width:112px;height:112px;border-radius:50%;left:25px;top:28px;display:grid;place-items:center;text-align:center;font-size:12px;line-height:1.15;font-weight:800;transform:rotate(-13deg);animation:bob 4s ease-in-out infinite alternate}.portrait-open{position:absolute;z-index:5;left:28px;bottom:26px;width:132px;height:132px;border-radius:50%;display:grid;place-items:center;background:var(--ink);color:var(--lime);text-align:center;font-family:var(--font-display);font-size:21px;font-weight:800;line-height:1.05;letter-spacing:-.03em;box-shadow:0 18px 35px rgba(25,27,53,.24);animation:open-float 4.5s ease-in-out infinite alternate}.portrait-name{position:absolute;z-index:5;right:30px;bottom:26px;color:white;font-family:'Bricolage Grotesque',sans-serif;font-size:clamp(38px,4vw,60px);font-weight:800;letter-spacing:-.06em;line-height:.9;transform:rotate(-7deg)}
      .section-heading{display:flex;align-items:end;justify-content:space-between;gap:35px;margin-bottom:29px}.section-heading h2{font-size:clamp(51px,5vw,76px);letter-spacing:-.05em;line-height:.98;margin:0}.section-heading p{font-size:15px;line-height:1.65;font-weight:600;max-width:370px;color:var(--muted);margin:0 0 5px}.tiles{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:18px}.tile{border-radius:20px;padding:35px;min-height:360px;position:relative;overflow:hidden;transition:transform .5s cubic-bezier(.16,1,.3,1),box-shadow .5s}.tile:hover{transform:translateY(-7px);box-shadow:0 24px 35px rgba(24,28,55,.12)}.tile .number{font-size:12px;font-weight:800;letter-spacing:.08em}.tile h3{font-size:clamp(40px,4vw,57px);letter-spacing:-.05em;line-height:1;margin:28px 0 18px;max-width:450px}.tile p{font-size:15px;line-height:1.65;font-weight:600;max-width:390px;margin:0}.mobile{grid-column:span 7;background:#dfe8ff}.mobile::after{content:'↗';font-family:'Bricolage Grotesque',sans-serif;position:absolute;font-size:280px;color:#b4c8ff;right:18px;bottom:-78px;line-height:1;pointer-events:none}.frontend{grid-column:span 5;background:#dcff79}.frontend::after{content:'✳';font-size:210px;color:#c7ed63;position:absolute;right:-28px;bottom:-65px;pointer-events:none}.detail{grid-column:span 5;background:var(--blue);color:white}.detail p{color:#e4e1ff}.detail::after{content:'◒';font-size:280px;position:absolute;color:#4f46dc;right:-42px;bottom:-100px;pointer-events:none}.background{grid-column:span 7;background:#f6d5d9;color:#5d1b2a}.background::after{content:'~';font-family:'Bricolage Grotesque',sans-serif;font-size:380px;line-height:.6;position:absolute;right:15px;bottom:12px;color:#eab2be;pointer-events:none}.tile>*{position:relative;z-index:1}
      .experience{padding:105px 0}.experience-grid{display:grid;grid-template-columns:1fr 1.25fr;gap:18px}.experience-intro{background:var(--ink);color:white;border-radius:20px;padding:42px;min-height:470px;display:flex;flex-direction:column;justify-content:space-between}.experience-intro h2{font-size:clamp(51px,5vw,76px);letter-spacing:-.05em;line-height:1;margin:0}.experience-intro h2 em{font-style:normal;color:var(--lime)}.experience-intro p{font-size:15px;line-height:1.7;color:#d5d7e9;max-width:380px;margin:0}.experience-list{background:var(--white);border-radius:20px;padding:16px 34px}.role{padding:29px 0;border-bottom:1px solid #dfe0ec;display:grid;grid-template-columns:1fr 2fr;gap:20px}.role:last-child{border-bottom:0}.role small{font-size:11px;letter-spacing:.1em;font-weight:800;text-transform:uppercase;color:var(--blue)}.role h3{font-size:24px;letter-spacing:-.04em;margin:0 0 8px}.role p{font-size:13px;line-height:1.6;color:var(--muted);font-weight:600;margin:0}
      .contact{background:var(--orange);border-radius:22px;padding:72px 74px;display:flex;align-items:end;justify-content:space-between;gap:40px;overflow:hidden;position:relative;margin-bottom:30px}.contact::after{content:'✳';position:absolute;font-size:350px;line-height:1;right:60px;top:-160px;color:rgba(255,255,255,.22);animation:twirl 28s linear infinite}.contact h2{font-size:clamp(49px,5.5vw,84px);line-height:.94;letter-spacing:-.05em;max-width:760px;margin:0;position:relative;z-index:1}.contact .button{background:var(--ink);color:white;flex:none;position:relative;z-index:1}.contact .button:hover{background:var(--blue)}.footer{display:flex;justify-content:space-between;gap:30px;padding:18px 0 32px;font-size:12px;font-weight:700;color:#5a5d75}
      @keyframes bob{to{transform:rotate(-7deg) translateY(-9px)}}@keyframes twirl{to{transform:rotate(360deg)}}@keyframes open-float{from{transform:translateY(0) rotate(-10deg)}to{transform:translateY(-13px) rotate(-4deg)}}
      @media(max-width:1080px){.hero{grid-template-columns:1fr 1fr}.hero-copy{padding:48px}.hero h1{font-size:clamp(56px,6vw,75px)}.portrait-name{font-size:45px}.tile{min-height:340px}.tile h3{font-size:44px}}
      @media(max-width:800px){.shell{padding:0 16px}.topbar{height:70px}.brand{font-size:25px}.nav{gap:15px}.nav a:not(.nav-cta){display:none}.nav-cta{padding:12px 17px}.hero{grid-template-columns:1fr;gap:14px}.hero-copy{min-height:530px;padding:45px 35px}.hero h1{font-size:clamp(57px,9vw,78px);margin:40px 0 24px}.portrait{min-height:620px}.section-heading{display:block}.section-heading h2{margin-bottom:20px}.tiles{grid-template-columns:1fr 1fr;gap:14px}.tile{grid-column:span 2!important;min-height:300px}.experience{padding:70px 0}.experience-grid{grid-template-columns:1fr}.experience-intro{min-height:310px}.experience-list{padding:12px 30px}.contact{display:block;padding:50px 35px}.contact h2{margin-bottom:36px}.footer{flex-wrap:wrap}}
      @media(max-width:520px){.hero-copy{min-height:520px;padding:34px 25px}.hero h1{font-size:clamp(52px,13vw,66px)}.hero-lede{font-size:15px}.hero-actions{gap:14px}.button{min-height:52px;font-size:12px;padding:0 20px}.hero-copy::after{font-size:100px}.portrait{min-height:475px}.portrait-art{inset:35px 10px 0}.head{width:135px;height:160px;top:65px}.body-shape{height:270px;width:350px}.portrait-sticker{width:87px;height:87px;font-size:9px;top:18px;left:16px}.portrait-open{width:104px;height:104px;left:16px;bottom:18px;font-size:17px}.portrait-name{font-size:37px;right:15px;bottom:17px}.portrait::after{font-size:70px}.section-heading h2{font-size:48px}.section-heading p{font-size:13px}.tile{padding:25px;min-height:310px}.tile h3{font-size:42px}.tile p{font-size:13px}.mobile::after{font-size:190px}.frontend::after{font-size:160px}.background::after{font-size:260px}.experience-intro{padding:30px;min-height:320px}.experience-intro h2{font-size:58px}.experience-list{padding:5px 24px}.role{display:block;padding:24px 0}.role small{display:block;margin-bottom:12px}.role h3{font-size:22px}.contact{padding:43px 28px}.contact h2{font-size:51px}.footer{font-size:11px}}
      @media(prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation:none!important;transition:none!important}}

  @media(max-width:520px){.hero h1{font-size:49px;letter-spacing:-.04em}.hero-actions{gap:8px}.hero-actions .button{padding-inline:15px;gap:10px;font-size:11px}.quiet-link{font-size:11px}}
</style>
