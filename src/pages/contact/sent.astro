---
import Base from '../../layouts/Base.astro';
---
<Base title="Message sent — Adefila Abdulmuiz" description="Thanks for getting in touch with Adefila Abdulmuiz." noindex>
  <section class="sent">
    <div class="mark" aria-hidden="true">✳</div>
    <h1>Thanks for<br /><em>reaching out.</em></h1>
    <p>Your message is on its way. I'll get back to you as soon as I can.</p>
    <a class="button button-lime" href="/">Back to home ↗</a>
  </section>
</Base>
<style>
  .sent{min-height:670px;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;position:relative;overflow:hidden;background:var(--blue);color:white;border-radius:22px;padding:clamp(40px,8vw,110px)}.mark{position:absolute;right:5%;top:3%;font-size:clamp(180px,28vw,380px);line-height:1;color:var(--orange);animation:spin 28s linear infinite}.sent h1{position:relative;z-index:1;font-size:clamp(60px,8vw,96px);line-height:.95;letter-spacing:-.04em;margin:0 0 30px}.sent h1 em{font-style:normal;color:var(--lime)}.sent p{position:relative;z-index:1;max-width:460px;font-size:17px;line-height:1.7;color:#edeaff;margin-bottom:32px}.sent .button{position:relative;z-index:1}@media(max-width:520px){.sent{min-height:600px;padding:35px 25px}.mark{right:-10%;top:8%;font-size:210px;opacity:.65}.sent h1{font-size:58px}.sent p{font-size:15px}}
</style>
