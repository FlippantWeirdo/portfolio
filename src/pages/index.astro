---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import Ticker from '../components/Ticker.astro';
import { work } from '../data/work';
---
<Base title="Adefila Abdulmuiz — Mobile & frontend developer" description="Adefila Abdulmuiz builds mobile apps and web experiences, taking the frontend from interface to API integration. Explore Nokslock, Flamingo, Rosie, and more.">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">I build mobile<br class="hero-break" /> apps and web<br class="hero-break" /> <span class="feel">experiences.</span></h1>
      <p class="hero-intro">I'm <strong>Adefila Abdulmuiz</strong>. I take the frontend from interface to API integration.</p>
      <div class="hero-actions"><a class="button button-lime" href="#work">Explore the work <span aria-hidden="true">↘︎</span></a><a class="button button-secondary" href="/contact">Get in touch <span aria-hidden="true">↗︎</span></a></div>
      <div class="hero-note">Flutter · React Native · React · TypeScript</div>
    </div>
    <div class="hero-art">
      <div class="orbit-label">OPEN TO<br />WORK</div>
      <div class="phone phone-back"><div class="island"></div><img src="/images/projects/nokslock-add.png" alt="" fetchpriority="high" /></div>
      <div class="phone phone-front"><div class="island"></div><img src="/images/projects/flamingo-shop.png" alt="" fetchpriority="high" /></div>
      <svg class="shape-star" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true"><path d="M50 0 58 34 83 11 66 42 100 50 66 58 83 89 58 66 50 100 42 66 17 89 34 58 0 50 34 42 17 11 42 34Z"/></svg>
    </div>
  </section>
  <Ticker items={['MOBILE THAT MATTERS', 'FRONTEND WITH FEELING', 'IDEAS IN MOTION']} />
  <section id="work" aria-labelledby="work-title">
    <div class="section-intro"><h2 id="work-title">Built & shipped.</h2><p>Real products, different problems, one obsession: making every interaction count.</p></div>
    <div class="work-grid">{work.map((project) => <WorkCard project={project} />)}</div>
    <p class="all-work"><a href="/software">Explore the work in more detail <span aria-hidden="true">↗︎</span></a></p>
  </section>
  <section class="between" aria-labelledby="about-title"><h2 id="about-title">Useful first.<br /><em>Memorable always.</em></h2><div><p>I work across mobile apps and the web, bringing careful details and a sense of play to software people actually use.</p><a href="/about">More about me ↗︎</a></div></section>
  <section class="contact" aria-labelledby="contact-title"><h2 id="contact-title">Have a role or an idea? Let's talk.</h2><a class="button button-dark" href="/contact">Get in touch ↗︎</a></section>
</Base>
<style>
  .hero{min-height:694px;background:var(--blue);color:white;position:relative;overflow:hidden;border-radius:22px;display:grid;grid-template-columns:57% 43%;isolation:isolate}.hero::after{content:"";position:absolute;width:520px;height:520px;border:1px solid rgba(255,255,255,.22);border-radius:50%;right:-145px;top:8px;box-shadow:0 0 0 110px rgba(255,255,255,.04),0 0 0 215px rgba(255,255,255,.035);pointer-events:none;z-index:-1}
  .hero-copy{padding:88px 0 84px 7.2%;position:relative;z-index:3;display:flex;flex-direction:column;align-items:flex-start}.hero h1{font-size:clamp(66px,6.15vw,98px);line-height:.93;letter-spacing:-.04em;font-weight:800;max-width:850px;margin:0 0 34px}.feel{color:var(--lime);font-style:italic;display:inline-block;transform:rotate(-4deg);transform-origin:left bottom}.hero-intro{max-width:470px;font-size:17px;line-height:1.7;font-weight:500;color:#edeaff;margin:0 0 40px}.hero-intro strong{color:white;font-weight:800}.hero-actions{display:flex;flex-wrap:wrap;align-items:center;gap:16px}.button-secondary{border:1.5px solid rgba(255,255,255,.55);color:white}.button-secondary:hover{background:rgba(255,255,255,.13)}.hero-note{margin-top:auto;padding-top:50px;font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;color:#d8d5ff}
  .hero-art{position:relative;min-height:694px}.orbit-label{position:absolute;right:37px;top:49px;z-index:5;width:112px;height:112px;border-radius:50%;background:var(--orange);color:var(--ink);display:grid;place-items:center;text-align:center;font-size:12px;line-height:1.3;font-weight:800;letter-spacing:.02em;transform:rotate(14deg);animation:bob 4s ease-in-out infinite alternate}.orbit-label::before{content:"✳︎";position:absolute;font-size:20px;top:10px;right:16px}.phone{position:absolute;background:#151626;border:8px solid #18192a;border-radius:39px;box-shadow:0 30px 55px rgba(11,8,71,.36);overflow:hidden;transition:transform .65s cubic-bezier(.16,1,.3,1)}.phone img{width:100%;height:100%;object-fit:cover;object-position:top}.island{position:absolute;top:8px;left:50%;transform:translateX(-50%);width:70px;height:18px;background:#171717;border-radius:50px;z-index:2}.phone-back{width:265px;height:575px;top:105px;left:-28px;transform:rotate(-13deg);z-index:2}.phone-front{width:285px;height:617px;top:99px;left:175px;transform:rotate(11deg);z-index:3}.hero:hover .phone-back{transform:rotate(-17deg) translate(-10px,-10px)}.hero:hover .phone-front{transform:rotate(15deg) translate(13px,-12px)}.shape-star{position:absolute;left:35px;bottom:34px;width:92px;height:92px;color:var(--lime);z-index:4;animation:spin 18s linear infinite}
  .work-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:18px}.all-work{text-align:right;margin:25px 0 0;font-size:13px;font-weight:800}.all-work a{border-bottom:2px solid var(--orange);padding-bottom:5px}.all-work a:hover{color:var(--blue)}
  .between{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center;margin:112px 0 105px}.between h2{font-weight:800;letter-spacing:-.04em;line-height:1.02;font-size:clamp(47px,5vw,73px);margin:0}.between h2 em{color:var(--blue);font-style:normal}.between p{font-size:17px;line-height:1.75;max-width:480px;margin:0 0 15px;color:#494d65}.between a{font-size:14px;font-weight:800;border-bottom:2px solid var(--orange);padding-bottom:5px}
  .contact{background:var(--orange);border-radius:22px;padding:72px 74px;display:flex;align-items:end;justify-content:space-between;gap:50px;color:var(--ink);margin-bottom:30px;overflow:hidden;position:relative}.contact::after{content:"✳︎";position:absolute;font-family:var(--font-display);font-size:350px;line-height:1;right:85px;top:-150px;color:rgba(255,255,255,.2);pointer-events:none;animation:spin 28s linear infinite}.contact h2{font-size:clamp(50px,5.5vw,84px);letter-spacing:-.04em;line-height:.94;margin:0;max-width:790px;position:relative;z-index:1}.contact .button{position:relative;z-index:1;flex:none}
  @media(max-width:1100px){.hero{grid-template-columns:55% 45%}.hero-copy{padding-top:75px}.hero h1{font-size:clamp(64px,7vw,86px)}.phone-back{left:-30px}.phone-front{left:130px}}
  @media(max-width:800px){.hero{display:block;border-radius:16px;min-height:900px}.hero-copy{padding:55px 27px 0}.hero-art{height:470px;min-height:470px}.hero h1{font-size:clamp(55px,11vw,78px);max-width:650px}.hero-intro{font-size:15px;max-width:490px}.hero-note{display:none}.phone-back{width:185px;height:400px;top:52px;left:calc(50% - 170px);border-width:6px;border-radius:28px}.phone-front{width:195px;height:425px;top:27px;left:calc(50% - 8px);border-width:6px;border-radius:28px}.orbit-label{right:5%;top:-35px;width:83px;height:83px;font-size:9px}.orbit-label::before{font-size:15px;top:7px;right:10px}.shape-star{bottom:5px;left:8%}.work-grid{grid-template-columns:1fr 1fr;gap:14px}.between{grid-template-columns:1fr;gap:20px;margin:75px 0}.between h2{font-size:58px}.contact{display:block;padding:44px 30px}.contact h2{font-size:57px}}
  @media(max-width:520px){.hero{min-height:836px}.hero-copy{padding:48px 23px 0}.hero h1{font-size:50px}.hero-break{display:none}.hero-intro{font-size:14px;margin-bottom:25px}.hero-actions{gap:9px}.hero-art{height:360px;min-height:360px}.phone-back{width:155px;height:335px;top:38px;left:calc(50% - 137px)}.phone-front{width:165px;height:359px;top:17px;left:calc(50% - 7px)}.orbit-label{top:-22px;right:4%}.between h2{font-size:50px}.between p{font-size:14px}.contact h2{font-size:51px}}
</style>
