---
import Base from '../layouts/Base.astro';
import WorkCard from '../components/WorkCard.astro';
import Ticker from '../components/Ticker.astro';
import { work } from '../data/work';

const stack = [
  { area: 'Mobile', tools: ['Flutter', 'React Native'] },
  { area: 'Web', tools: ['React', 'Next.js', 'Astro', 'TanStack Start', 'TypeScript', 'JavaScript', 'HTML & CSS'] },
  { area: 'Data & services', tools: ['REST APIs', 'Supabase', 'Firebase', 'RevenueCat'] },
  { area: 'State & workflow', tools: ['Provider', 'Zustand', 'Git', 'Figma'] },
];
---
<Base title="Work — Adefila Abdulmuiz" description="Mobile apps, dashboards, and websites built by Adefila Abdulmuiz, including Nokslock, Flamingo, Rosie, Caxten Engineering, and QSTC.">
  <section class="intro" aria-labelledby="work-title">
    <div class="intro-copy"><h1 id="work-title">The work,<br /><em>up close.</em></h1><p>Mobile apps, dashboards, and websites. Different challenges, the same care for how each thing works and feels.</p><a class="stack-jump" href="#stack">See the stack behind the work ↓</a></div>
    <div class="intro-art" aria-hidden="true"><span class="asterisk">✳</span><span class="orbit">BUILT TO<br />MOVE</span></div>
  </section>
  <Ticker items={['MADE FOR REAL PEOPLE', 'DESIGNED TO FEEL GOOD', 'BUILT TO WORK']} />
  <div class="section-intro"><h2>Built & shipped.</h2><p>Open a project to see the screens and the part I played in building it.</p></div>
  <section class="work-grid" aria-label="Projects">{work.map((project) => <WorkCard project={project} />)}</section>
  <section id="stack" class="stack-section" aria-labelledby="stack-title">
    <div class="stack-intro"><h2 id="stack-title">The stack behind the work.</h2><p>Tools I use to take an interface from a design into a working product.</p></div>
    <div class="stack-groups">
      {stack.map((group) => <div class="stack-group"><h3>{group.area}</h3><ul>{group.tools.map((tool) => <li>{tool}</li>)}</ul></div>)}
    </div>
  </section>
  <section class="close"><h2>Want to make something good together?</h2><a class="button button-dark" href="/contact">Let's talk ↗</a></section>
</Base>
<style>
  .intro{min-height:550px;background:var(--white);border-radius:22px;display:grid;grid-template-columns:1.1fr .9fr;overflow:hidden;position:relative;margin-bottom:0}.intro-copy{padding:80px 7%;position:relative;z-index:1}.intro h1{font-size:clamp(70px,7vw,100px);line-height:.94;letter-spacing:-.04em;margin:0 0 38px}.intro h1 em{color:var(--blue);font-style:normal}.intro p{font-size:18px;line-height:1.7;font-weight:600;color:var(--muted);max-width:520px}.intro-art{position:relative;background:#dfe8ff;overflow:hidden}.intro-art::before{content:"";position:absolute;width:580px;height:580px;border:1px solid #b4c8ff;border-radius:50%;left:15%;top:-9%;box-shadow:0 0 0 90px #d2dfff,0 0 0 180px #e3ebff}.asterisk{position:absolute;font-size:340px;line-height:1;left:20%;top:12%;font-family:var(--font-display);color:var(--blue);animation:spin 30s linear infinite}.orbit{position:absolute;right:40px;bottom:40px;background:var(--lime);width:135px;height:135px;border-radius:50%;display:grid;place-items:center;text-align:center;font-size:13px;font-weight:800;transform:rotate(12deg);animation:bob 4s ease-in-out infinite alternate}
  .stack-jump{display:inline-block;margin-top:12px;padding-bottom:6px;border-bottom:2px solid var(--orange);font-size:14px;font-weight:800}.stack-jump:hover{color:var(--blue)}.work-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:18px}.stack-section{scroll-margin-top:30px;display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:55px;margin-top:100px;padding:clamp(40px,5vw,72px);border-radius:22px;background:var(--ink);color:white}.stack-intro h2{font-size:clamp(47px,4.8vw,72px);line-height:1;letter-spacing:-.04em;max-width:540px;margin:0 0 25px}.stack-intro p{max-width:340px;color:#d9dbeb;font-size:15px;line-height:1.7;font-weight:600}.stack-groups{display:grid}.stack-group{display:grid;grid-template-columns:150px minmax(0,1fr);gap:22px;align-items:start;padding:24px 0;border-bottom:1px solid rgba(255,255,255,.24)}.stack-group:first-child{border-top:1px solid rgba(255,255,255,.24)}.stack-group h3{font-size:14px;line-height:1.5;margin:5px 0 0}.stack-group ul{list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:9px}.stack-group li{background:rgba(255,255,255,.12);border-radius:9px;padding:8px 11px;font-size:13px;font-weight:700;line-height:1.3}.close{margin:100px 0 30px;padding:70px;background:var(--orange);border-radius:22px;display:flex;align-items:end;justify-content:space-between;gap:30px}.close h2{font-size:clamp(48px,5vw,76px);line-height:1;letter-spacing:-.04em;max-width:760px;margin:0}.close .button{flex:none}
  @media(max-width:800px){.intro{grid-template-columns:1fr}.intro-copy{padding:55px 35px}.intro h1{font-size:75px}.intro-art{min-height:260px}.asterisk{font-size:240px;top:-15%;left:25%}.orbit{width:105px;height:105px;right:20px;bottom:20px;font-size:10px}.work-grid{grid-template-columns:1fr 1fr;gap:14px}.stack-section{grid-template-columns:1fr;gap:12px;margin-top:70px}.stack-intro h2{max-width:650px}.close{padding:44px 30px;display:block}.close h2{margin-bottom:30px}}
  @media(max-width:520px){.intro-copy{padding:45px 25px}.intro h1{font-size:61px}.intro p{font-size:14px}.intro-art{min-height:220px}.asterisk{font-size:190px}.stack-jump{font-size:12px}.stack-section{padding:35px 26px}.stack-intro h2{font-size:48px}.stack-group{grid-template-columns:1fr;gap:12px}.stack-group li{font-size:12px}.close{margin-top:70px}.close h2{font-size:51px}}
</style>
