---
import Base from '../../layouts/Base.astro';
import { work, type WorkProject } from '../../data/work';

export function getStaticPaths() {
  return work.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: WorkProject };
const next = work[(work.findIndex((item) => item.slug === project.slug) + 1) % work.length];
const isWide = ['admin', 'caxten', 'qstc'].includes(project.tone);
---
<Base title={`${project.title} — Adefila Abdulmuiz`} description={project.intro}>
  <a class="back" href="/software">← All work</a>
  <section class:list={['hero', project.tone]} aria-labelledby="project-title">
    <div class="hero-copy">
      <p class="category">{project.category} · {project.status}</p>
      <h1 id="project-title">{project.title}</h1>
      <p class="lede">{project.intro}</p>
      {(project.link || project.secondaryLink) && <div class="hero-links">
        {project.link && <a class="button button-dark" href={project.link.url} target="_blank" rel="noopener noreferrer">{project.link.label} ↗</a>}
        {project.secondaryLink && <a class="button button-dark" href={project.secondaryLink.url} target="_blank" rel="noopener noreferrer">{project.secondaryLink.label} ↗</a>}
      </div>}
    </div>
    <div class:list={['hero-visual', { wide: isWide }]} aria-hidden="true">
      <img src={project.images[0].src} alt="" fetchpriority="high" />
    </div>
  </section>
  <section class="facts" aria-label="Project details">
    <div><span>My role</span><strong>{project.role}</strong></div>
    <div><span>Platform</span><strong>{project.stack.join(' · ')}</strong></div>
    <div><span>Status</span><strong>{project.status}</strong></div>
  </section>
  <section class="story" aria-labelledby="story-title">
    <div><h2 id="story-title">The part I played.</h2><p>{project.storyIntro ?? 'My contribution to the product.'}</p></div>
    <ul>{project.contribution.map((item) => <li>{item}</li>)}</ul>
  </section>
  <section class="gallery" aria-labelledby="gallery-title">
    <div class="section-intro"><h2 id="gallery-title">On screen.</h2><p>A closer look at the product and the details that shape the experience.</p></div>
    <div class:list={['gallery-grid', { wide: isWide }]}>
      {project.images.map((image) => <figure class:list={{wide:image.wide}}><img src={image.src} alt={image.alt} loading="lazy" decoding="async" /><figcaption>{image.alt}{image.note && <span>{image.note}</span>}</figcaption></figure>)}
    </div>
  </section>
  <section class="next"><div><span>Next project</span><h2>{next.title}</h2></div><a class="button button-lime" href={`/work/${next.slug}`}>Explore project ↗</a></section>
</Base>
<style>
  .hero-links{display:flex;flex-wrap:wrap;gap:12px}
  .back{display:inline-block;font-size:13px;font-weight:800;margin:10px 0 22px;border-bottom:2px solid var(--orange);padding-bottom:5px}.back:hover{color:var(--blue)}
  .hero{border-radius:22px;min-height:640px;overflow:hidden;display:grid;grid-template-columns:1fr .85fr;isolation:isolate;position:relative}.hero-copy{padding:clamp(40px,5vw,80px);position:relative;z-index:2}.category{font-size:11px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;margin-bottom:70px}.hero h1{font-size:clamp(65px,6.5vw,100px);font-weight:800;letter-spacing:-.04em;line-height:.95;margin:0 0 28px}.lede{font-size:18px;font-weight:600;line-height:1.7;max-width:550px;margin:0 0 36px}.hero-visual{position:relative;overflow:hidden}.hero-visual::before{content:"";position:absolute;width:620px;height:620px;border-radius:50%;background:rgba(255,255,255,.2);top:9%;left:4%}.hero-visual img{position:absolute;max-width:none;width:min(360px,73%);height:auto;max-height:690px;object-fit:cover;object-position:top;top:13%;left:22%;transform:rotate(9deg);border-radius:20px;box-shadow:0 30px 55px rgba(25,27,53,.26)}.hero-visual.wide img{width:780px;max-height:none;top:29%;left:2%;transform:rotate(-7deg);border-radius:11px;border:6px solid white}.hero.nokslock{background:#dfe8ff}.hero.flamingo{background:#121e0b;color:#f5f9eb}.hero.flamingo .lede{color:#d5e0d1}.hero.admin{background:#eaffad}.hero.rosie{background:#f6d5d9;color:#5d1b2a}.hero.caxten{background:#1f2841;color:white}.hero.caxten .lede{color:#dfe5ef}.hero.qstc{background:#fcae78;color:#442613}
  .facts{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;padding:34px 5px 55px;border-bottom:1px solid #d9dbe8}.facts div{display:grid;gap:8px}.facts span{font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:var(--blue)}.facts strong{font-size:15px;line-height:1.5}
  .story{display:grid;grid-template-columns:1fr 1fr;gap:60px;padding:100px 0}.story h2{font-size:clamp(50px,5vw,76px);letter-spacing:-.04em;line-height:1;margin:0 0 18px}.story p{font-size:15px;line-height:1.7;color:var(--muted);font-weight:600;max-width:430px}.story ul{list-style:none;padding:0;margin:0}.story li{font-size:20px;font-weight:700;line-height:1.55;padding:22px 0;border-bottom:1px solid #cdd0e0}.story li:first-child{border-top:1px solid #cdd0e0}
  .gallery{padding-bottom:100px}.gallery-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.gallery-grid figure{background:var(--white);border-radius:20px;margin:0;padding:35px;min-height:650px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:25px;overflow:hidden}.gallery-grid img{max-height:550px;width:auto;object-fit:contain;border-radius:13px;box-shadow:0 25px 45px rgba(25,27,53,.13)}.gallery-grid figcaption{width:100%;font-size:12px;font-weight:800;color:var(--muted);line-height:1.6}.gallery-grid figcaption span{display:block;font-weight:600;margin-top:5px}.gallery-grid figure.wide{grid-column:1/-1;min-height:0}.gallery-grid figure.wide img{width:100%;max-height:none}.gallery-grid.wide{grid-template-columns:1fr}.gallery-grid.wide figure{min-height:0}.gallery-grid.wide img{width:100%;max-height:none}
  .next{background:var(--blue);color:white;border-radius:22px;padding:55px 65px;display:flex;align-items:end;justify-content:space-between;gap:25px;margin-bottom:30px}.next span{font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#d5d2ff}.next h2{font-size:clamp(48px,5vw,72px);letter-spacing:-.04em;margin:15px 0 0}.next .button{flex:none}
  @media(max-width:900px){.hero{grid-template-columns:1fr}.hero-copy{padding:48px}.hero h1{font-size:75px}.category{margin-bottom:40px}.hero-visual{min-height:490px}.hero-visual img{width:260px;max-height:500px;top:0;left:calc(50% - 130px)}.hero-visual.wide img{width:85%;top:15%;left:8%}.story{gap:30px}.gallery-grid figure{padding:25px;min-height:550px}}
  @media(max-width:600px){.hero-copy{padding:35px 26px}.hero h1{font-size:58px}.lede{font-size:14px}.hero-visual{min-height:385px}.hero-visual img{width:210px;left:calc(50% - 105px)}.hero-visual.wide{min-height:260px}.hero-visual.wide img{top:5%}.facts{grid-template-columns:1fr;gap:25px}.story{grid-template-columns:1fr;padding:70px 0}.story h2{font-size:51px}.story li{font-size:16px}.gallery{padding-bottom:70px}.gallery-grid{grid-template-columns:1fr}.gallery-grid figure{min-height:0;padding:25px}.gallery-grid img{max-height:520px}.next{padding:38px 26px;display:block}.next h2{font-size:50px;margin-bottom:25px}}
</style>
